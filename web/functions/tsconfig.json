{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Cloudflare Pages Functions (TASKS V2-D4): a worker runtime — fetch, Request,
    // Response, Web Crypto and WebAssembly, no Node and no vite client types.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "rootDir": ".",
    "outDir": "./dist-types",
    "tsBuildInfoFile": "./dist-types/.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "include": ["**/*.ts"],
  "exclude": ["dist-types"],
  "references": [{ "path": ".." }]
}
