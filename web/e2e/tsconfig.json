{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // The harness is a Node program driving a browser; the DOM lib is for the callbacks
    // `page.evaluate` ships into the page, which are type-checked here, not there.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "./dist-types",
    "tsBuildInfoFile": "./dist-types/.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "include": ["**/*.ts"],
  "exclude": ["dist-types"],
  "references": [{ "path": "../../packages/contracts" }, { "path": ".." }]
}
