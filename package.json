{
  "name": "fire-watch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Near-real-time wildfire situational-awareness map and alerts for Bulgaria and the Balkans",
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "typecheck": "tsc --build --verbose",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter \"@fire-watch/web...\" run build && vitest run --project e2e",
    "test:budgets": "pnpm --filter \"@fire-watch/web...\" run build && vitest run --project budgets",
    "test:timing": "pnpm --filter \"@fire-watch/web...\" run build && vitest run --project timing --reporter=verbose",
    "test:watch": "vitest --project unit",
    "dev:live": "pnpm --filter @fire-watch/server build && node server/dist/app/dev-live-cli.js",
    "fit": "pnpm --filter @fire-watch/server build && node server/dist/app/fit-cli.js",
    "constellation-replay": "pnpm --filter @fire-watch/server build && node server/dist/app/constellation-replay-cli.js",
    "curation-rehearsal": "pnpm --filter @fire-watch/server build && node server/dist/app/curation-rehearsal-cli.js",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages server web",
    "audit": "pnpm audit --audit-level=high",
    "deploy-gate": "tsc --build infra/deploy-gate && node infra/deploy-gate/dist/cli.js",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format && pnpm run boundaries && pnpm run test",
    "loadtest": "tsc --build loadtest && node loadtest/dist/src/adapters/cli.js",
    "tiles": "tsc --build infra/tiles && node infra/tiles/dist/cli.js",
    "geodata": "tsc --build infra/geodata && node infra/geodata/dist/cli.js",
    "geodata:static-sources": "tsc --build infra/geodata && node infra/geodata/dist/static-sources-cli.js",
    "geodata:effis-ba": "tsc --build infra/geodata && node infra/geodata/dist/effis-ba-candidates-cli.js",
    "geodata:natura2000": "tsc --build infra/geodata && node infra/geodata/dist/natura2000-cli.js",
    "geodata:landcover-web": "tsc --build infra/geodata && node infra/geodata/dist/landcover-web-cli.js",
    "geodata:worldcover": "tsc --build infra/geodata && node infra/geodata/dist/worldcover-cli.js",
    "status": "tsc --build infra/status && node infra/status/dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
